# ============================================
# RifaApp — Variables de Entorno
# ============================================
# Copia este archivo como .env y configura los valores

# Base de datos
# SQLite (desarrollo):
DATABASE_URL="file:./dev.db"
# PostgreSQL (producción):
# DATABASE_URL="postgresql://user:password@localhost:5432/rifaapp?schema=public"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV="development"

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:5173"

# Uploads
UPLOAD_DIR="./uploads"
CACHE_DIR="./cache"
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

